# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# ── Site ─────────────────────────────────────────────
# Public URL used for canonical links, the sitemap and share images.
# Leave empty on Vercel until you have a domain: the Vercel production URL is used.
NEXT_PUBLIC_SITE_URL=

# ── Forms (Resend) ───────────────────────────────────
# API key from https://resend.com/api-keys (server-only, never exposed to the browser).
RESEND_API_KEY=
# Where form submissions are delivered. Comma-separate for several inboxes.
CONTACT_TO_EMAIL=inspyrproject@gmail.com
# Sender. Must use a domain verified in Resend. Until then, the Resend test
# sender below works, but it can only deliver to the email that owns the Resend account.
CONTACT_FROM_EMAIL="Project INSPYR <onboarding@resend.dev>"
# true = log submissions to the server console instead of sending (for testing).
# Without RESEND_API_KEY, local development behaves this way automatically.
FORMS_DRY_RUN=false

# ── Analytics (optional, privacy-friendly) ───────────
# off | vercel | plausible
NEXT_PUBLIC_ANALYTICS=off
# Only for plausible, e.g. projectinspyr.org
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Content editor (/keystatic) ──────────────────────
# Created by the one-time editor setup (see README). Import the generated .env into Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# local = edit the files on this computer instead of GitHub (development only).
NEXT_PUBLIC_KEYSTATIC_STORAGE=
